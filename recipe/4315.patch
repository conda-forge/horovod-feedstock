From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: njzjz-bot <48687836+njzjz-bot@users.noreply.github.com>
Date: Sun, 31 May 2026 06:55:00 +0000
Subject: [PATCH] Avoid torch/extension.h for PyTorch 2.10 on osx-arm64

PyTorch 2.10's conda package exposes torch/extension.h via the top-level
include directory during osx-arm64 cross builds, but that header includes
<torch/all.h>, which is not present at that location. Horovod only needs the
C++ API in these translation units, so include <torch/torch.h> directly and
avoid forcing the extension header macro.
---
 horovod/torch/CMakeLists.txt | 2 +-
 horovod/torch/adapter_v2.h   | 1 -
 horovod/torch/mpi_ops_v2.cc  | 1 -
 3 files changed, 1 insertion(+), 3 deletions(-)

diff --git a/horovod/torch/CMakeLists.txt b/horovod/torch/CMakeLists.txt
index d54329dff..c2163a000 100644
--- a/horovod/torch/CMakeLists.txt
+++ b/horovod/torch/CMakeLists.txt
@@ -63,7 +63,7 @@ if(HAVE_ROCM)
 endif()
 list(APPEND PYTORCH_LINKER_LIBS ${Pytorch_LIBRARIES})
 parse_version(${Pytorch_VERSION} VERSION_DEC)
-add_definitions(-DPYTORCH_VERSION=${VERSION_DEC} -DTORCH_API_INCLUDE_EXTENSION_H=1)
+add_definitions(-DPYTORCH_VERSION=${VERSION_DEC})
 set(Pytorch_CXX11 ${Pytorch_CXX11} PARENT_SCOPE)
 if(NOT Pytorch_VERSION VERSION_LESS "2.1.0")
     set(CMAKE_CXX_STANDARD 17)
diff --git a/horovod/torch/adapter_v2.h b/horovod/torch/adapter_v2.h
index 473f92320..113ddbba0 100644
--- a/horovod/torch/adapter_v2.h
+++ b/horovod/torch/adapter_v2.h
@@ -16,7 +16,6 @@
 #ifndef HOROVOD_TORCH_ADAPTER_V2_H
 #define HOROVOD_TORCH_ADAPTER_V2_H
 
-#include <torch/extension.h>
 #include <torch/torch.h>
 
 #include "../common/common.h"
diff --git a/horovod/torch/mpi_ops_v2.cc b/horovod/torch/mpi_ops_v2.cc
index 1b82ce966..3f72662c9 100644
--- a/horovod/torch/mpi_ops_v2.cc
+++ b/horovod/torch/mpi_ops_v2.cc
@@ -23,7 +23,6 @@
 #include <chrono>
 #include <memory>
 #include <thread>
-#include <torch/extension.h>
 #include <torch/torch.h>
 
 // Undef LOG macro from Torch
-- 
